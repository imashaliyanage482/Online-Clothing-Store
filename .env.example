# Environment Variables Example for FashionStore

# Required: MongoDB is the source of truth; empty collections are seeded from src/data/db.json once.
# Database-backed requests fail if MongoDB is unavailable.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/fashion_store?retryWrites=true&w=majority"

# MySQL Connection String (used only by the optional Prisma schema)
DATABASE_URL="mysql://root:password@localhost:3306/fashionstore"

# Authentication Secrets
JWT_SECRET="fashionstore-super-secure-production-jwt-secret-key-32chars"

# App Public Domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"
